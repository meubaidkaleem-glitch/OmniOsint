# Text files are stored with LF and checked out with LF everywhere, except
# Windows scripts, which need CRLF to run reliably under cmd.exe and
# Windows PowerShell.
* text=auto eol=lf

*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf
*.psm1 text eol=crlf

*.sh   text eol=lf

*.png  binary
*.ico  binary
*.icns binary
*.zip  binary
