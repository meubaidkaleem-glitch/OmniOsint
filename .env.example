# Example environment configuration for OmniOSINT.
#
# Copy to `.env` in the project folder, or in the data directory
# (%LOCALAPPDATA%\OmniOSINT\.env on Windows, ~/.local/share/OmniOSINT/.env on
# Linux), and keep only the lines you need. Never commit a real .env file.
#
# Prefer the protected secret store for passwords:
#     omniosint secrets set database.password
# Values set here are plain text on disk.
#
# Every setting in config/settings.yaml can be given here as
# OMNIOSINT_<SECTION>__<NAME>, for example OMNIOSINT_SERVER__PORT.

# --- Database --------------------------------------------------------------
# Either the individual settings ...
# OMNIOSINT_DATABASE__HOST=127.0.0.1
# OMNIOSINT_DATABASE__PORT=5432
# OMNIOSINT_DATABASE__NAME=omniosint
# OMNIOSINT_DATABASE__USER=omniosint
# OMNIOSINT_DATABASE__PASSWORD=change-me
# ... or one URL (overrides the individual settings):
# OMNIOSINT_DATABASE__URL=postgresql://omniosint:change-me@127.0.0.1:5432/omniosint

# --- Redis (optional) --------------------------------------------------------
# OMNIOSINT_REDIS__URL=redis://127.0.0.1:6379/0

# --- Interface -----------------------------------------------------------------
# OMNIOSINT_SERVER__PORT=8765
# OMNIOSINT_LOGGING__LEVEL=INFO

# --- Data directory --------------------------------------------------------
# Where configuration, logs, backups and the secret store live.
# OMNIOSINT_HOME=D:\OmniOSINT-data

# --- Development only ---------------------------------------------------------
# OMNIOSINT_ENVIRONMENT=development      enables /api/docs
# OMNIOSINT_SERVER__CORS_ORIGINS=["http://localhost:5173"]

# --- Tests (see docs/DEVELOPER_GUIDE.md) --------------------------------------
# OMNIOSINT_TEST_DATABASE_URL=postgresql://omniosint:secret@127.0.0.1:5432/omniosint_test
# OMNIOSINT_TEST_ADMIN_DATABASE_URL=postgresql://postgres:secret@127.0.0.1:5432/postgres
# OMNIOSINT_TEST_REDIS_URL=redis://127.0.0.1:6379/15
# OMNIOSINT_E2E_DATABASE_URL=postgresql://omniosint:secret@127.0.0.1:5432/omniosint_e2e
